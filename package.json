{
  "name": "spillcheck",
  "version": "0.1.0",
  "private": true,
  "description": "Versioning and release tooling for the Spillcheck macOS app",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "changeset": "changeset",
    "changeset:check": "node scripts/check-changesets.mjs",
    "version:release": "node scripts/version-release.mjs",
    "release:check": "node scripts/release-metadata.mjs",
    "test:release": "node --test Tests/Tooling/release*.test.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "semver": "7.8.5",
    "yaml": "2.9.1"
  }
}
